  :root { color-scheme: light dark; --bg: #f4f1ec; --fg: #141414; --muted: #5f5b54; --line: #d1cabe; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0e0e0e; --fg: #f3f1ec; --muted: #a3a09a; --line: #383838; }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    background: var(--bg);
    color: var(--fg);
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  main { width: 100%; max-width: 76rem; margin: 0 auto; padding: 4rem 1.5rem; }
  .brand { margin: 0; font-size: 0.875rem; font-weight: 600; }
  h1 {
    margin: 1.5rem 0 0;
    max-width: 40rem;
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }
  p.lead { margin: 1.25rem 0 0; max-width: 36rem; font-size: 1.0625rem; line-height: 1.6; color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
  .button {
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 999px;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }
  .primary { border: 0; background: var(--fg); color: var(--bg); }
  .secondary { border: 1px solid var(--line); background: transparent; color: var(--fg); }
  .button:focus-visible { outline: 2px solid #e0307a; outline-offset: 2px; }
